	<style>
		.error {
			color: red;
		}

		.desktop-nav .navbar .navbar-nav .nav-item a {
			font-size: 13px;
		}

		/* marquee */

		.uni-news-ticker {
			width: 100%;
			display: flex;
			align-items: center;
			background: #172f41;
			height: 48px;
			overflow: hidden;
			font-family: 'Segoe UI', sans-serif;
		}


		.uni-news-label {
			display: flex;
			height: 48px;
			align-items: center;
			gap: 8px;
			padding: 0 18px;
			background: #92210f;
			color: #fff;
			font-weight: 600;
			font-size: 16px;
			white-space: nowrap;
			border-right: 1px solid rgba(255, 255, 255, 0.15);
		}

		.uni-news-label i {
			font-size: 16px;
		}


		.uni-news-track {
			flex: 1;
			overflow: hidden;
			position: relative;
		}

		.uni-news-content {
			display: inline-block;
			white-space: nowrap;
			color: #f1f5f9;
			font-size: 14px;
			padding-left: 100%;
			animation: uniScroll 30s linear infinite;
		}

		.uni-news-content a {
			color: #ffd166;
			text-decoration: none;
			font-weight: 500;
		}

		.uni-news-content a:hover {
			text-decoration: underline;
		}


		@keyframes uniScroll {
			0% {
				transform: translateX(0);
			}

			100% {
				transform: translateX(-100%);
			}
		}


		.uni-news-ticker:hover .uni-news-content {
			animation-play-state: paused;
		}
	</style>
